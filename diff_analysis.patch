+export const generatePermanentToken = catchAsync(async (req, res, next) => {
+    // Generate a token signed with the normal secret, but with no expiration
+    // and a 'type: permanent' payload that isn't tied to a real DB user.
+    const payload = {
+        sub: req.user.id,
+        role: req.user.role,
+        type: 'permanent'
+    };
+
+    const token = jwt.sign(payload, env.JWT_SECRET); // No expiresIn option
+
+    logger.info(`Permanent WS token generated by ${req.user?.username || 'Admin'}`);
+
+    sendSuccess(res, 200, {
+        message: 'Permanent token generated successfully',
+        token,
+        note: 'This token never expires and only works for WebSocket connections.'
+    });
+});
