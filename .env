# Environment
ENVIRONMENT=development
ALLOWED_ORIGINS=*

# WEBRTC CONFIG
MAX_PEER_TOTAL=100
MAX_PEER_PER_ROOM=20
ICE_TIMEOUT_SECONDS=20
HEARTBEAT_TIMEOUT_SECONDS=400
ENABLE_RATE_LIMIT=true
MAX_OFFER_PER_MINUTE=40
