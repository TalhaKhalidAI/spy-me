# ==========================================
# Core Server Configuration
# ==========================================
NODE_ENV=production
PORT=5050
WS_PORT=5050
LISTEN_IP=0.0.0.0
LOG_LEVEL=info

# ==========================================
# SSL & Security
# ==========================================
HTTPS_ENABLED=true
SSL_KEY_PATH=./src/certs/status.lab.mli.key
SSL_CERT_PATH=./src/certs/status.lab.mli.crt
CORS_ORIGIN=*

# ==========================================
# Database
# ==========================================
DATABASE_ENABLED=true
DATABASE_URL=file:./dev.db

# ==========================================
# WebRTC (Mediasoup) Settings
# ==========================================
ANNOUNCED_IP=192.168.100.185
WORKER_MAX=2
RTC_MIN_PORT=2000
RTC_MAX_PORT=20200
MAX_TRANSPORTS_PER_PEER=10
STUN_SERVERS=stun:192.168.100.9:3478,stun:192.168.100.9:5349,stun:stun.l.google.com:19302

# ==========================================
# Authentication (JWT)
# ==========================================
JWT_SECRET=f3746580c7dd4ab36fdeaf16ad42abcb
JWT_REFRESH_SECRET=579ee8fde023ef16f17e9b6aa5495594
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ==========================================
# Admin Account Defaults
# ==========================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
ADMIN_EMAIL=admin@talha.pk

# ==========================================
# Rate Limiting
# ==========================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=96000
RATE_LIMIT_MAX=100000

