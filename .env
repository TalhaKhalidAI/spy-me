# Security (REQUIRED)
SECRET_KEY=64cda4a6222bd19ee3c857b2ba00904d
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=790

# Database
SQLITE_DATABASE_URL=sqlite:///./spyme.db

# Logging
LOG_FILEPATH=./logs/

# Rate Limiting
RATE_LIMIT_DEFAULT=100/minute

# Maintenance
KILL_SWITCH_ENABLED=false

# Argon2 Hashing
MEMORY_COST=65536
PARALLELISM=2
HASH_LENGTH=32
SALT_LENGTH=16

# Admin User (REQUIRED)
